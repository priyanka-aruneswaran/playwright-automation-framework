{
  "name": "messaging-playwright-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "A small Playwright and TypeScript messaging-app test framework.",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:all": "playwright test",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
